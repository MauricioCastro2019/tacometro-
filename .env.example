FLASK_ENV=production
SECRET_KEY=cambia-esto-por-una-clave-segura-minimo-32-caracteres
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Usuario que se promueve a admin automáticamente al arrancar
# Debe coincidir exactamente con el username registrado
ADMIN_USERNAME=tuusuarioadmin

# Cloudflare R2 — almacenamiento de imágenes (recomendado)
R2_ACCOUNT_ID=tu-account-id-de-cloudflare
R2_ACCESS_KEY_ID=tu-r2-access-key-id
R2_SECRET_ACCESS_KEY=tu-r2-secret-access-key
R2_BUCKET_NAME=tacometro-images
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# Cloudinary — almacenamiento alternativo (si no usas R2)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
